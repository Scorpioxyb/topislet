.build/
# Non-regenerable local data (raw QA samples, release candidates, rollback copies).
# Kept outside .build/ because `swift package clean` empties that whole directory.
/LocalData/
.swiftpm/
.DS_Store
__pycache__/
*.app/
Reports/
DerivedData/
*.xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Local investigation extracts from third-party app bundles. Keep them on disk if useful,
# but do not track proprietary generated JavaScript in this product repository.
desktopLyrics-*.js
player-*.js
index.js
package.json
