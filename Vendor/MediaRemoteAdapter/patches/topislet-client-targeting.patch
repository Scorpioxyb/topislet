diff --git a/src/adapter/get_client.m b/src/adapter/get_client.m
new file mode 100644
index 0000000..3c556b0
--- /dev/null
+++ b/src/adapter/get_client.m
@@ -0,0 +1,98 @@
+// Copyright (c) 2025 Jonas van den Berg
+// This file is licensed under the BSD 3-Clause License.
+
+#import "get_client.h"
+
+#import "MediaRemoteAdapter.h"
+#import "adapter/client.h"
+#import "adapter/env.h"
+#import "adapter/globals.h"
+#import "adapter/keys.h"
+#import "adapter/now_playing.h"
+#import "utility/helpers.h"
+
+#define GET_CLIENT_TIMEOUT_MILLIS 2000
+#define JSON_NULL @"null"
+
+NSDictionary *internal_get_client(NSString *bundleIdentifier) {
+    if (!g_mediaRemote.getNowPlayingInfoForClient ||
+        !g_mediaRemote.getLocalOrigin ||
+        !g_mediaRemote.clientGetProcessIdentifier) {
+        return nil;
+    }
+
+    id clientObject = findNowPlayingClient(bundleIdentifier);
+    const void *origin = g_mediaRemote.getLocalOrigin();
+    if (!clientObject || !origin) {
+        return nil;
+    }
+
+    NSString *microsOption = getEnvOption(@"micros");
+    NSString *humanReadableOption = getEnvOption(@"human-readable");
+    NSString *nowOption = getEnvOption(@"now");
+    NSString *noArtworkOption = getEnvOption(@"no-artwork");
+    const bool convertMicros = microsOption != nil;
+    const bool humanReadable = humanReadableOption != nil;
+    const bool calculateNow = nowOption != nil;
+    const bool noArtwork = noArtworkOption != nil;
+
+    const void *client = (__bridge const void *)clientObject;
+    dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
+    __block NSDictionary *information = nil;
+    g_mediaRemote.getNowPlayingInfoForClient(
+        client, origin, !noArtwork, g_serialdispatchQueue,
+        ^(CFDictionaryRef value, const void *error) {
+          information = (__bridge NSDictionary *)value;
+          dispatch_semaphore_signal(semaphore);
+        });
+
+    dispatch_time_t timeout = dispatch_time(
+        DISPATCH_TIME_NOW, GET_CLIENT_TIMEOUT_MILLIS * NSEC_PER_MSEC);
+    if (dispatch_semaphore_wait(semaphore, timeout) != 0 || !information) {
+        return nil;
+    }
+
+    NSMutableDictionary *result = convertNowPlayingInformation(
+        information, convertMicros, calculateNow, noArtwork);
+    pid_t pid = g_mediaRemote.clientGetProcessIdentifier(client);
+    if (pid > 0) {
+        result[kMRAProcessIdentifier] = @(pid);
+    }
+    CFStringRef bundle = g_mediaRemote.clientGetBundleIdentifier(client);
+    if (bundle) {
+        result[kMRABundleIdentifier] = (__bridge NSString *)bundle;
+    }
+    CFStringRef parent =
+        g_mediaRemote.clientGetParentAppBundleIdentifier(client);
+    if (parent) {
+        result[kMRAParentApplicationBundleIdentifier] =
+            (__bridge NSString *)parent;
+    }
+    NSNumber *playbackRate = result[kMRAPlaybackRate];
+    if ([playbackRate isKindOfClass:[NSNumber class]]) {
+        result[kMRAPlaying] = @([playbackRate doubleValue] > 0.01);
+    }
+
+    if (humanReadable) {
+        makePayloadHumanReadable(result);
+    }
+    return allMandatoryPayloadKeysSet(result) ? result : nil;
+}
+
+void adapter_get_client(NSString *bundleIdentifier) {
+    NSDictionary *result = internal_get_client(bundleIdentifier);
+    NSString *serialized = result
+        ? serializeJsonDictionarySafe(
+              result, getEnvOption(@"human-readable") != nil)
+        : JSON_NULL;
+    if (!serialized) {
+        fail(@"Failed to serialize targeted now playing information");
+    }
+    printOut(serialized);
+}
+
+void adapter_get_client_env() {
+    NSString *bundleIdentifier =
+        getEnvFuncParamSafe(@"adapter_get_client", 0, @"bundle");
+    adapter_get_client(bundleIdentifier);
+}
