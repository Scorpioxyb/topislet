 #import <Foundation/Foundation.h>
 
 #import "MediaRemoteAdapter.h"
+#import "adapter/client.h"
 #import "adapter/env.h"
 #import "adapter/globals.h"
 #import "adapter/now_playing.h"
 #import "utility/helpers.h"
 
 static NSArray<NSNumber *> *acceptedCommands;
+static NSArray<NSNumber *> *acceptedClientCommands;
+
+#define CLIENT_COMMAND_COMPLETION_TIMEOUT_MILLIS 500
 
 __attribute__((constructor)) static void init() {
     acceptedCommands = @[
@@ -31,6 +35,11 @@
         @(kMRAGoBackFifteenSeconds),
         @(kMRASkipFifteenSeconds),
     ];
+    acceptedClientCommands = @[
+        @(kMRATogglePlayPause),
+        @(kMRANextTrack),
+        @(kMRAPreviousTrack),
+    ];
     // TODO like/unlike tracks by reading now playing information first,
     // getting the track ID, station ID and station hash
     // and then sending the respective MRCommand.
@@ -67,3 +76,53 @@ static inline int send_0_command() {
 }
 
 void adapter_send_env() { adapter_send((MRACommand)send_0_command()); }
+
+void adapter_send_client(NSString *bundleIdentifier, MRACommand command) {
+    bool ok = false;
+    MRCommand commandValue = findCommand((int)command, &ok);
+    if (!ok || ![acceptedClientCommands containsObject:@(command)]) {
+        failf(@"Invalid targeted command: %d", command);
+    }
+    if ([bundleIdentifier length] == 0 ||
+        !g_mediaRemote.sendCommandToClient || !g_mediaRemote.getLocalOrigin) {
+        fail(@"Targeted MediaRemote control is unavailable");
+    }
+
+    id clientObject = findNowPlayingClient(bundleIdentifier);
+    const void *origin = g_mediaRemote.getLocalOrigin();
+    if (!clientObject || !origin) {
+        failf(@"MediaRemote client not found: %@", bundleIdentifier);
+    }
+
+    dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
+    __block uint32_t sendError = UINT32_MAX;
+    bool accepted = g_mediaRemote.sendCommandToClient(
+        commandValue, nil, origin, (__bridge const void *)clientObject, NULL,
+        g_serialdispatchQueue,
+        ^(uint32_t error, CFArrayRef handlerStatuses) {
+          sendError = error;
+          dispatch_semaphore_signal(semaphore);
+        });
+    if (!accepted) {
+        failf(@"Failed to send targeted command %d", command);
+    }
+
+    dispatch_time_t timeout = dispatch_time(
+        DISPATCH_TIME_NOW,
+        CLIENT_COMMAND_COMPLETION_TIMEOUT_MILLIS * NSEC_PER_MSEC);
+    if (dispatch_semaphore_wait(semaphore, timeout) != 0) {
+        failf(@"Timed out sending targeted command %d", command);
+    }
+    if (sendError != 0) {
+        failf(@"Targeted command %d failed with error %u", command, sendError);
+    }
+    printOut(@"targetedControlSent=true");
+}
+
+void adapter_send_client_env() {
+    NSString *bundleIdentifier =
+        getEnvFuncParamSafe(@"adapter_send_client", 0, @"bundle");
+    int command =
+        getEnvFuncParamIntSafe(@"adapter_send_client", 1, @"command");
+    adapter_send_client(bundleIdentifier, (MRACommand)command);
+}
diff --git a/src/adapter/stream_client.m b/src/adapter/stream_client.m
new file mode 100644
index 0000000..5b5c538
--- /dev/null
+++ b/src/adapter/stream_client.m
@@ -0,0 +1,84 @@
+// Copyright (c) 2025 Jonas van den Berg
+// This file is licensed under the BSD 3-Clause License.
+
+#import <AppKit/AppKit.h>
+#import <Foundation/Foundation.h>
+
+#import "adapter/env.h"
+#import "adapter/client.h"
+#import "adapter/get_client.h"
+#import "adapter/globals.h"
+#import "private/MediaRemote.h"
+#import "utility/Debounce.h"
+#import "utility/helpers.h"
+
+static NSString *serializeClientData(NSDictionary *data) {
+    return serializeJsonDictionarySafe(
+        @{
+            @"type" : @"data",
+            @"diff" : @NO,
+            @"payload" : data ?: @{},
+        },
+        getEnvOption(@"human-readable") != nil);
+}
+
+void adapter_stream_client(NSString *bundleIdentifier) {
+    int debounceMillis = 60;
+    NSNumber *debounceOption = getEnvOptionInt(@"debounce");
+    if (debounceOption != nil) {
+        debounceMillis = MAX(0, [debounceOption intValue]);
+    }
+    dispatch_queue_t fetchQueue = dispatch_queue_create(
+        "mediaremote-adapter.client-stream", DISPATCH_QUEUE_SERIAL);
+    Debounce *debounce = [[Debounce alloc]
+        initWithDelay:(debounceMillis / 1000.0)
+                 queue:fetchQueue];
+
+    void (^emit)() = ^{
+      NSDictionary *data = internal_get_client(bundleIdentifier);
+      NSString *serialized = serializeClientData(data);
+      if (serialized) {
+          printOutUnique(serialized);
+      }
+    };
+    void (^scheduleEmit)() = ^{
+      [debounce call:emit];
+    };
+
+    dispatch_async(fetchQueue, emit);
+
+    NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+    NSMutableArray *observers = [NSMutableArray array];
+    for (NSString *name in @[
+             kMRMediaRemoteNowPlayingInfoDidChangeNotification,
+             kMRMediaRemoteNowPlayingPlaybackQueueDidChangeNotification,
+             kMRMediaRemoteNowPlayingApplicationIsPlayingDidChangeNotification,
+             kMRMediaRemoteNowPlayingApplicationDidChangeNotification,
+         ]) {
+        id observer = [center addObserverForName:name
+                                         object:nil
+                                          queue:nil
+                                     usingBlock:^(NSNotification *note) {
+                                       if ([note.name isEqualToString:
+                                                kMRMediaRemoteNowPlayingApplicationDidChangeNotification]) {
+                                           invalidateNowPlayingClientCache();
+                                       }
+                                       scheduleEmit();
+                                     }];
+        [observers addObject:observer];
+    }
+
+    g_mediaRemote.registerForNowPlayingNotifications(g_serialdispatchQueue);
+    CFRunLoopRun();
+    g_mediaRemote.unregisterForNowPlayingNotifications();
+    for (id observer in observers) {
+        [center removeObserver:observer];
+    }
+    invalidateNowPlayingClientCache();
+}
+
+void adapter_stream_client_env() {
+    NSString *bundleIdentifier =
+        getEnvFuncParamSafe(@"adapter_stream_client", 0, @"bundle");
+    adapter_stream_client(bundleIdentifier);
+}
