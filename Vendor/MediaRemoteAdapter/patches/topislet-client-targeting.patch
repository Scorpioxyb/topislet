diff --git a/src/adapter/client.m b/src/adapter/client.m
new file mode 100644
index 0000000..d06b23f
--- /dev/null
+++ b/src/adapter/client.m
@@ -0,0 +1,122 @@
+// Copyright (c) 2025 Jonas van den Berg
+// This file is licensed under the BSD 3-Clause License.
+
+#import "client.h"
+
+#import "adapter/globals.h"
+#import "utility/helpers.h"
+
+#define CLIENT_LOOKUP_TIMEOUT_MILLIS 1000
+
+static id g_cachedClient = nil;
+static NSString *g_cachedBundleIdentifier = nil;
+static pid_t g_cachedProcessIdentifier = 0;
+static NSObject *g_clientCacheLock = nil;
+
+static NSObject *clientCacheLock(void) {
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        g_clientCacheLock = [NSObject new];
+    });
+    return g_clientCacheLock;
+}
+
+void invalidateNowPlayingClientCache(void) {
+    @synchronized (clientCacheLock()) {
+        g_cachedClient = nil;
+        g_cachedBundleIdentifier = nil;
+        g_cachedProcessIdentifier = 0;
+    }
+}
+
+static BOOL cachedClientStillTargets(NSString *bundleIdentifier) {
+    if (!g_cachedClient ||
+        ![g_cachedBundleIdentifier isEqualToString:bundleIdentifier] ||
+        !g_mediaRemote.clientGetBundleIdentifier ||
+        !g_mediaRemote.clientGetParentAppBundleIdentifier) {
+        return NO;
+    }
+
+    const void *client = (__bridge const void *)g_cachedClient;
+    CFStringRef bundle = g_mediaRemote.clientGetBundleIdentifier(client);
+    CFStringRef parent =
+        g_mediaRemote.clientGetParentAppBundleIdentifier(client);
+    BOOL matches = (bundle && [(__bridge NSString *)bundle
+                               isEqualToString:bundleIdentifier]) ||
+                   (parent && [(__bridge NSString *)parent
+                               isEqualToString:bundleIdentifier]);
+    if (!matches) {
+        return NO;
+    }
+
+    if (g_mediaRemote.clientGetProcessIdentifier) {
+        pid_t processIdentifier =
+            g_mediaRemote.clientGetProcessIdentifier(client);
+        if (processIdentifier <= 0 ||
+            processIdentifier != g_cachedProcessIdentifier) {
+            return NO;
+        }
+        NSRunningApplication *application =
+            [NSRunningApplication runningApplicationWithProcessIdentifier:
+                                      processIdentifier];
+        if (!application || application.isTerminated) {
+            return NO;
+        }
+    }
+    return YES;
+}
+
+id findNowPlayingClient(NSString *bundleIdentifier) {
+    if ([bundleIdentifier length] == 0 ||
+        !g_mediaRemote.getNowPlayingClients ||
+        !g_mediaRemote.clientGetBundleIdentifier ||
+        !g_mediaRemote.clientGetParentAppBundleIdentifier) {
+        return nil;
+    }
+
+    @synchronized (clientCacheLock()) {
+        if (cachedClientStillTargets(bundleIdentifier)) {
+            return g_cachedClient;
+        }
+        g_cachedClient = nil;
+        g_cachedBundleIdentifier = nil;
+        g_cachedProcessIdentifier = 0;
+    }
+
+    dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
+    __block NSArray *clients = nil;
+    g_mediaRemote.getNowPlayingClients(g_serialdispatchQueue,
+                                       ^(CFArrayRef value) {
+      clients = (__bridge NSArray *)value;
+      dispatch_semaphore_signal(semaphore);
+    });
+
+    dispatch_time_t timeout = dispatch_time(
+        DISPATCH_TIME_NOW, CLIENT_LOOKUP_TIMEOUT_MILLIS * NSEC_PER_MSEC);
+    if (dispatch_semaphore_wait(semaphore, timeout) != 0) {
+        return nil;
+    }
+
+    for (id candidate in clients) {
+        const void *client = (__bridge const void *)candidate;
+        CFStringRef bundle =
+            g_mediaRemote.clientGetBundleIdentifier(client);
+        CFStringRef parent =
+            g_mediaRemote.clientGetParentAppBundleIdentifier(client);
+        if ((bundle && [(__bridge NSString *)bundle
+                           isEqualToString:bundleIdentifier]) ||
+            (parent && [(__bridge NSString *)parent
+                           isEqualToString:bundleIdentifier])) {
+            @synchronized (clientCacheLock()) {
+                g_cachedClient = candidate;
+                g_cachedBundleIdentifier = [bundleIdentifier copy];
+                g_cachedProcessIdentifier =
+                    g_mediaRemote.clientGetProcessIdentifier
+                        ? g_mediaRemote.clientGetProcessIdentifier(client)
+                        : 0;
+            }
+            return candidate;
+        }
+    }
+    return nil;
+}
